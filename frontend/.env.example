# Public base URL of the backend. No trailing slash.
#   local:    http://127.0.0.1:8123
#   deployed: https://<your-service>.onrender.com
VITE_API_BASE_URL=http://127.0.0.1:8123

# Shared bearer token. NOTE: Vite inlines VITE_* vars into the client bundle,
# so this token is public to anyone who loads the page. That is inherent to the
# single-shared-token design in ARCHITECTURE.md; recorded in README limitations.
VITE_SHARED_TOKEN=replace-me
