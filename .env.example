# ── Backend ──────────────────────────────────────────────────────────────
# Neon Postgres. Must include ?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Shared bearer token for every /api/* route.  Generate with:
#   openssl rand -hex 24
SHARED_TOKEN=replace-me

# P5: demo preserves the shared-token flow. Production requires all three
# distinct tokens (24+ characters); do not put service/approver tokens in the
# browser bundle. Provision schema with an owner before starting the API.
AUTH_MODE=demo
# LOADER_SERVICE_TOKEN=generate-separate-random-token
# APPROVER_TOKEN=generate-another-random-token
# For the separate loader process, set AUTH_MODE=production plus:
# P5_LOADER_SERVICE_TOKEN=same-value-as-backend-LOADER_SERVICE_TOKEN
# P4_LOADER_DATABASE_URL=postgresql://p5_loader:...
# P4_AGENT_API_URL=https://api.example
# For the human approver process, set AUTH_MODE=production plus:
# P5_APPROVER_TOKEN=same-value-as-backend-APPROVER_TOKEN
# Offline migration/role verification only (never pass owner URL to API/loader):
# P5_MIGRATION_DATABASE_URL=postgresql://schema_owner:...
# P5_API_DATABASE_URL=postgresql://p5_api:...
# P5_AUDIT_DATABASE_URL=postgresql://read_only_auditor:...

# P6 versioned object feed (loader/Airflow worker only; never browser/API):
# P6_ORDERS_BUCKET=versioned-orders-bucket
# P6_S3_REGION=us-east-1
# P6_S3_ENDPOINT_URL=https://s3-compatible.example
# Use the runtime's standard AWS credential chain or workload identity.

# P7 SQS-to-Airflow bridge process only. Set the same P6_ORDERS_BUCKET.
# P7_EXPECTED_ACCOUNT_ID=111122223333
# P7_EXPECTED_REGION=us-east-1
# P7_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/111122223333/orders-events
# P7_AIRFLOW_API_URL=https://airflow.example
# P7_AIRFLOW_BEARER_TOKEN=separate-airflow-dag-trigger-credential

# Comma-separated allow-list. Add the real Vercel origin once it exists.
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

APP_ENV=local

# Optional. Namespace for mapping_state rows -- leave unset to use "default"
# (what the real app reads). Set only for isolated test runs.
# PIPELINE_ENV=default

# ── Phase 3: required for diagnose/specialists/propose_patch to do anything ─
# useful. Without it every LLM node fails cleanly and the run escalates
# (nodes must never raise) -- Phases 0-2 don't need this at all.
# Free tier: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# P2 named table source (optional). Export this into the backend process
# environment; config/sources.yaml contains only the allowlisted table name.
# Use a separate Postgres role with SELECT on that table only. No CREATE,
# INSERT, UPDATE, DELETE, or access to the application's mapping tables.
# P2_SOURCE_DATABASE_URL=postgresql://readonly:password@host/db?sslmode=require
# Approval examples stay off until independent labels and a held-out A/B
# comparison justify opt-in. Never enable this solely from validation passes.
# ENABLE_APPROVAL_EXAMPLES=0

# ── Observability: LangSmith tracing (optional, opt-in, default OFF) ───────
# LangGraph auto-instruments every graph run once these are REAL process
# environment variables -- LangSmith's own SDK reads os.environ directly at
# trace time, not through this app's config.py/Settings. That's why this is
# genuinely env-var-only: no application code (here or in graph/nodes/**)
# ever references these names. On Render, set them as real dashboard env
# vars, same as DATABASE_URL/SHARED_TOKEN. For local dev, export them in
# your shell before starting run_local.py -- writing them into backend/.env
# alone does NOT work, since config.Settings never forwards arbitrary .env
# keys into os.environ (see README "Observability" for the exact commands
# this was verified with).
#
# Leaving LANGSMITH_TRACING unset/false, or LANGSMITH_API_KEY blank/invalid,
# must never break a run -- every node already tolerates its own failures
# (ARCHITECTURE.md's "nodes must never raise"), and a tracing backend being
# unreachable is no different. Verified against day4_combo both ways.
# LANGSMITH_TRACING=true
# Free tier: https://smith.langchain.com/ (Settings -> API Keys)
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=self-healing-data-pipeline
