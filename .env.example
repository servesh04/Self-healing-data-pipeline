# ── Backend ──────────────────────────────────────────────────────────────
# Neon Postgres. Must include ?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Shared bearer token for every /api/* route.  Generate with:
#   openssl rand -hex 24
SHARED_TOKEN=replace-me

# Comma-separated allow-list. Add the real Vercel origin once it exists.
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

APP_ENV=local

# Optional. Namespace for mapping_state rows -- leave unset to use "default"
# (what the real app reads). Set only for isolated test runs.
# PIPELINE_ENV=default

# ── Phase 3: required for diagnose/specialists/propose_patch to do anything ─
# useful. Without it every LLM node fails cleanly and the run escalates
# (nodes must never raise) -- Phases 0-2 don't need this at all.
# Free tier: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# ── Observability: LangSmith tracing (optional, opt-in, default OFF) ───────
# LangGraph auto-instruments every graph run once these are REAL process
# environment variables -- LangSmith's own SDK reads os.environ directly at
# trace time, not through this app's config.py/Settings. That's why this is
# genuinely env-var-only: no application code (here or in graph/nodes/**)
# ever references these names. On Render, set them as real dashboard env
# vars, same as DATABASE_URL/SHARED_TOKEN. For local dev, export them in
# your shell before starting run_local.py -- writing them into backend/.env
# alone does NOT work, since config.Settings never forwards arbitrary .env
# keys into os.environ (see README "Observability" for the exact commands
# this was verified with).
#
# Leaving LANGSMITH_TRACING unset/false, or LANGSMITH_API_KEY blank/invalid,
# must never break a run -- every node already tolerates its own failures
# (ARCHITECTURE.md's "nodes must never raise"), and a tracing backend being
# unreachable is no different. Verified against day4_combo both ways.
# LANGSMITH_TRACING=true
# Free tier: https://smith.langchain.com/ (Settings -> API Keys)
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=self-healing-data-pipeline
